NODE_ENV=development
PORT=8000
HOST=localhost
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:8081

DATABASE_URL=postgresql://postgres:password@localhost:5432/subflow

JWT_ACCESS_SECRET=replace_with_at_least_64_random_characters
JWT_REFRESH_SECRET=replace_with_another_at_least_64_random_characters
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

CLERK_SECRET_KEY=replace_with_clerk_secret_key

STRIPE_SECRET_KEY=replace_with_stripe_secret_key
STRIPE_WEBHOOK_SECRET=replace_with_stripe_webhook_secret
STRIPE_SUCCESS_URL=https://example.com/success
STRIPE_CANCEL_URL=https://example.com/cancel

STRIPE_PRO_MONTHLY_PRICE_ID=replace_with_monthly_price_id
STRIPE_PRO_YEARLY_PRICE_ID=replace_with_yearly_price_id

NOTIFICATION_REMINDER_DAYS=1
NOTIFICATION_REMINDER_CRON=0 9 * * *